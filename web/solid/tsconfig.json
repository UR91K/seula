{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // ../shared has no node_modules of its own; its tests import vitest from here.
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src", "../shared"]
}
