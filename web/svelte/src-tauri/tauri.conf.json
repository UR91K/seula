{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seula (svelte)",
  "version": "0.0.0",
  "identifier": "app.seula.shell.svelte",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Seula (svelte)", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
